# 이 파일을 .env 로 복사한 뒤 값을 채우세요. (.env 는 git 에 올라가지 않습니다)

# NEXON Open API — https://openapi.nexon.com 에서 발급
NEXON_API_KEY=

# 길드 식별
GUILD_NAME=나비
WORLD_NAME=오로라

# DynamoDB
DYNAMODB_TABLE=maple_guild
AWS_REGION=ap-northeast-1

# AWS 자격증명 (aws configure 로 설정했다면 생략 가능)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# 검증 임계값 (선택 — 미설정 시 기본값 사용)
# 직전 주차 대비 변동이 이 비율 이상이면 확인 권장 플래그
# SCORE_CHANGE_FLAG_RATIO=0.5
# 지하수로 점수의 현실적 범위 (자릿수 오인식 탐지용)
# SCORE_MIN_PLAUSIBLE=5000
# SCORE_MAX_PLAUSIBLE=500000
